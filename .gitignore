# OS files
.DS_Store
Thumbs.db

# Archives & Large files
*.zip
*.tar.gz
*.rar

# Dependencies
**/node_modules/
**/vendor/

# Environment files
**/.env
**/.env.*
!**/.env.example

# Build outputs
**/dist/
**/.tanstack/
**/*.tsbuildinfo
**/public/build/
**/public/hot/

# Logs & Caches
**/*.log
**/.phpunit.cache/
**/.phpunit.result.cache
**/bootstrap/cache/*
!**/bootstrap/cache/.gitignore
**/storage/*.key
**/storage/framework/cache/*
**/storage/framework/sessions/*
**/storage/framework/testing/*
**/storage/framework/views/*
**/storage/app/public/*
**/public/storage

# IDEs
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
